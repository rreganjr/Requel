.idea/
work/
target/
.m2/

# Defensive: any errant `npx`/`npm` invocation from the repo root materializes
# a node_modules tree here (vitest .vite cache, etc.). The real Angular deps
# live under requel-angular/node_modules, which is ignored by that subdir's
# own .gitignore.
node_modules/

# Playwright MCP browser tool session artifacts
/.playwright-mcp/

# Maven Javac compiler argument files (build artifacts)
**/javac.*.args

# E2E coverage reports (generated by scripts/e2e-with-coverage.sh)
/coverage/

# Local draft files (not for version control)
/commit.md
/ticket.md
