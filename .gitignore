.idea/
work/
target/
.m2/

# Secrets
.env

# direnv per-developer auto-loader (loads .env on cd; run `direnv allow` once)
.envrc

# Per-developer local AI-client config (MCP server wiring, machine-specific paths, tokens).
# The portable setup is documented in doc/mcp_remote_connection.md instead.
.cursor/
.claude/
# Codex stdio bridge wrapper (per-developer; reads the PAT from ~/.config, no secret in-file).
/scripts/requel-mcp.sh

# Defensive: any errant `npx`/`npm` invocation from the repo root materializes
# a node_modules tree here (vitest .vite cache, etc.). The real Angular deps
# live under requel-angular/node_modules, which is ignored by that subdir's
# own .gitignore.
node_modules/

# Playwright MCP browser tool session artifacts
/.playwright-mcp/

# Maven Javac compiler argument files (build artifacts)
**/javac.*.args

# E2E coverage reports (generated by scripts/e2e-with-coverage.sh)
/coverage/

# Local draft files (not for version control)
/commit.md
/pr.md
/ticket.md

# macOS Finder metadata (appears anywhere directories get browsed)
.DS_Store

# Local scratch (Claude/agent working files) — not tracked
/tmp/
# Cowork SendUserFile deliverables land here; plans/docs belong in doc/ instead.
/Claude outputs/
