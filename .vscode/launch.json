{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Requel [Run App]",
      "request": "launch",
      "mainClass": "com.rreganjr.requel.Application",
      "projectName": "requel-app",
      "args": "--spring.profiles.active=dev --server.port=8080",
      "vmArgs": "-Dspring.devtools.restart.enabled=false"
    },
    {
      "type": "node",
      "name": "Angular [ng serve]",
      "request": "launch",
      "cwd": "${workspaceFolder}/requel-angular",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ng", "serve", "--open"],
      "console": "integratedTerminal"
    }
  ]
}
