<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.rreganjr.requel</groupId>
    <artifactId>Requel-parent</artifactId>
    <version>2.0.0-dev</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>17</java.version>
    </properties>

    <!--
      Project-local Maven repository for jars that are not available on
      Maven Central. Currently houses jwnl 1.4-rc2 (the original
      SourceForge release; only 1.4_rc3 is on Central under
      net.sf.jwnl). The repository lives under lib/maven-repo with the
      standard groupId/artifactId/version/ layout, so any future legacy
      jar can be dropped in there without touching this block.

      ${maven.multiModuleProjectDirectory} resolves to the reactor root
      (provided by Maven 3.3+), so child modules inherit a path that
      points at the same lib/maven-repo regardless of which module is
      the active build directory.
    -->
    <repositories>
        <repository>
            <id>project-local</id>
            <name>Project-local repository for legacy jars</name>
            <url>file://${maven.multiModuleProjectDirectory}/lib/maven-repo</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
                <checksumPolicy>ignore</checksumPolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!--
                          Disable incremental compilation. When a compile fails mid-way (e.g. a
                          transitive dependency is missing from ~/.m2), the compiler writes stub
                          class files with "Unresolved compilation problem" embedded in their
                          bytecode. On the next run, Maven sees those files, considers the source
                          up-to-date, and skips recompilation — leaving the bad bytecode in place.
                          With incremental compilation off, every mvn compile/test-compile does a
                          full pass over the module's sources, so stale class files from a prior
                          failed compile can never hide a real error.
                        -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <!-- Avoid build failures in modules with no matching tests when -Dtest is used -->
                        <failIfNoTests>false</failIfNoTests>
                        <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.12</version>
                    <executions>
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                            <configuration>
                                <includes>
                                    <include>com/rreganjr/**</include>
                                </includes>
                                <formats>
                                    <format>HTML</format>
                                    <format>XML</format>
                                </formats>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.3.2</version>
                <executions>
                    <execution>
                        <id>clean-compiled-output</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <!--
                              IDE auto-builds can leave Eclipse compiler stubs in target/classes
                              that throw "Unresolved compilation problem" at runtime. Purge the
                              compiled output dirs at the start of every module build so mvn
                              test/verify always recompiles from source instead of trusting any
                              externally generated bytecode already sitting in target/.
                            -->
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                </fileset>
                                <fileset>
                                    <directory>${project.build.testOutputDirectory}</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <!-- Enforce Java 17 for the build to fail fast if an older JDK is used -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                    <message>Build requires JDK 17+. Set JAVA_HOME to a 17 JDK.</message>
                                </requireJavaVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>${java.version}</version>
                            <vendor>any</vendor>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>modules/platform-core</module>
        <module>modules/utils-jaxb</module>
        <module>modules/platform-identity</module>
        <module>modules/user-domain</module>
        <module>modules/user-jpa</module>
        <module>modules/dictionary-jpa</module>
        <module>modules/annotation-domain</module>
        <module>modules/annotation-jpa</module>
        <module>modules/project-domain</module>
        <module>modules/project-jpa</module>
        <module>modules/nlp-jpa</module>
        <module>modules/service-api</module>
        <module>modules/service-impl</module>
        <module>modules/requel-app</module>
  </modules>
</project>
