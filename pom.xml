<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.rreganjr.requel</groupId>
    <artifactId>Requel-parent</artifactId>
    <version>1.2.0</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>17</java.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!--
                          Disable incremental compilation. When a compile fails mid-way (e.g. a
                          transitive dependency is missing from ~/.m2), the compiler writes stub
                          class files with "Unresolved compilation problem" embedded in their
                          bytecode. On the next run, Maven sees those files, considers the source
                          up-to-date, and skips recompilation — leaving the bad bytecode in place.
                          With incremental compilation off, every mvn compile/test-compile does a
                          full pass over the module's sources, so stale class files from a prior
                          failed compile can never hide a real error.
                        -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <!-- Avoid build failures in modules with no matching tests when -Dtest is used -->
                        <failIfNoTests>false</failIfNoTests>
                        <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Enforce Java 17 for the build to fail fast if an older JDK is used -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                    <message>Build requires JDK 17+. Set JAVA_HOME to a 17 JDK.</message>
                                </requireJavaVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>${java.version}</version>
                            <vendor>any</vendor>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>modules/platform-core</module>
        <module>modules/utils-jaxb</module>
        <module>modules/platform-identity</module>
        <module>modules/user-domain</module>
        <module>modules/user-jpa</module>
        <module>modules/dictionary-jpa</module>
        <module>modules/annotation-domain</module>
        <module>modules/annotation-jpa</module>
        <module>modules/project-domain</module>
        <module>modules/project-jpa</module>
        <module>modules/nlp-jpa</module>
        <module>modules/service-api</module>
        <module>modules/service-impl</module>
        <module>modules/requel-app</module>
  </modules>
</project>
