{
  "name": "requel-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:coverage": "playwright test --config=playwright.coverage.config.ts",
    "ui-review": "playwright test --config=playwright.ui-review.config.ts",
    "build:stats": "ng build --stats-json",
    "lint": "eslint \"src/**/*.ts\""
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@fontsource-variable/figtree": "^5.3.0",
    "@primeuix/themes": "^2.0.3",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/angular": "^19.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "axe-core": "^4.12.1",
    "eslint": "^10.15.0",
    "jsdom": "^28.0.0",
    "monocart-reporter": "^2.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.0.8"
  },
  "//overrides": "#493: @angular/cli 21 pulls in glob 13, ignore-walk 8 and @tufjs/models 4, which still ask for minimatch ^10 (vulnerable below 11.0.1, GHSA in Dependabot alert 217). Drop each entry once that package asks for minimatch ^11 itself.",
  "overrides": {
    "glob": {
      "minimatch": "^11.0.1"
    },
    "ignore-walk": {
      "minimatch": "^11.0.1"
    },
    "@tufjs/models": {
      "minimatch": "^11.0.1"
    }
  }
}
