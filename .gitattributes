# Normalize line endings so a save from a different editor/OS doesn't re-churn
# whole files (see the CLAUDE.md whole-file diff on 761ee61b). git stores text as
# LF; working-tree endings are normalized on commit.
* text=auto

# Pin the endings that were flipping, and other source we always want as LF.
*.md   text eol=lf
*.sh   text eol=lf
*.ts   text eol=lf
*.html text eol=lf
*.scss text eol=lf
*.css  text eol=lf
*.java text eol=lf
*.xml  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows batch/PowerShell keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Common binaries — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.woff binary
*.woff2 binary
